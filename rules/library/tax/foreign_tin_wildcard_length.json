{
  "id": "library.tax.rule_foreign_tin_length",
  "type": "rule",
  "description": "Все foreignTin не длиннее 32",
  "role": "check",
  "operator": "length_max",
  "level": "ERROR",
  "code": "BEN.TAX.FOREIGN_TIN.LENGTH",
  "message": "Иностранный ИНН не должен превышать 32 символа",
  "field": "beneficiary.tax.foreignTin[*]",
  "value": 32,
  "aggregate": {
    "mode": "EACH",
    "onEmpty": "SKIP"
  }
}