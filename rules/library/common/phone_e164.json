{
  "id": "library.common.phone_e164",
  "type": "rule",
  "description": "Телефон в формате E.164",
  "role": "check",
  "operator": "matches_regex",
  "level": "ERROR",
  "code": "BEN.CONTACTS.PHONE.FORMAT",
  "message": "Телефон должен быть в международном формате E.164",
  "field": "beneficiary.contacts.phone",
  "value": "^\\+[1-9]\\d{7,14}$"
}