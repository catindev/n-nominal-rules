{
  "info": {
    "name": "Beneficiary Rule Engine Validation Suite",
    "_postman_id": "9db7779a-0f89-4db0-a7ee-f4c7a8dbe001",
    "description": "Прогон payload'ов против последнего пакета правил",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Validate case",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"context\": {\n    \"pipelineId\": \"{{pipelineId}}\",\n    \"merchantId\": \"demo-merchant\",\n    \"requestId\": \"{{case_id}}\"\n  },\n  \"payload\": {{payload_json}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/validate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "validate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "let body = {}; try { body = pm.response.json(); } catch (e) { body = {}; }",
              "function collectIssues(obj) {",
              "  if (!obj || typeof obj !== 'object') return [];",
              "  if (Array.isArray(obj.issues)) return obj.issues;",
              "  if (Array.isArray(obj.findings)) return obj.findings;",
              "  if (obj.result && Array.isArray(obj.result.issues)) return obj.result.issues;",
              "  if (Array.isArray(obj.results)) return obj.results;",
              "  return [];",
              "}",
              "const issues = collectIssues(body);",
              "const expectedCount = Number(pm.iterationData.get('expected_issue_count') || 0);",
              "pm.test('Issue count >= expected baseline', function () { pm.expect(issues.length).to.be.at.least(expectedCount); });",
              "const expectedCodesRaw = (pm.iterationData.get('expected_codes_csv') || '').trim();",
              "const expectedCodes = expectedCodesRaw ? expectedCodesRaw.split(',').map(s => s.trim()).filter(Boolean) : [];",
              "const actualCodes = issues.map(x => x.code || x.checkId || x.id).filter(Boolean);",
              "expectedCodes.forEach(function(code) {",
              "  pm.test('Contains expected code: ' + code, function () { pm.expect(actualCodes).to.include(code); });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}