{
  "id": "library.address.cond_country_if_present",
  "type": "condition",
  "description": "Если beneficiary.address.registration.countryCode заполнено, проверяем формат и запрет США",
  "when": {
    "all": [
      "library.address.pred_country_present"
    ]
  },
  "steps": [
    {
      "rule": "library.address.country"
    },
    {
      "rule": "library.address.country_not_us"
    }
  ]
}
