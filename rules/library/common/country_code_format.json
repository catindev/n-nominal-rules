{
  "id": "library.common.country_code_format",
  "type": "rule",
  "description": "Двухбуквенный код страны ISO 3166-1 alpha-2",
  "role": "check",
  "operator": "matches_regex",
  "level": "ERROR",
  "code": "COMMON.COUNTRY_CODE.FORMAT",
  "message": "Код страны должен состоять из двух заглавных латинских букв",
  "field": "__override__",
  "value": "^[A-Z]{2}$"
}