{
  "id": "library.address.cond_country_if_present",
  "type": "condition",
  "description": "Если страна адреса регистрации заполнена, проверяем формат и запрет США",
  "when": {
    "all": ["library.address.pred_country_present"]
  },
  "steps": [
    {
      "rule": "library.address.country"
    },
    {
      "rule": "library.address.country_not_us"
    }
  ]
}
