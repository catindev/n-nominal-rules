{
  "id": "library.common.rule_beneficiary_tax_foreignaddress_countrycode_format",
  "type": "rule",
  "description": "Код страны foreignAddress",
  "role": "check",
  "operator": "matches_regex",
  "field": "beneficiary.tax.foreignAddress.countryCode",
  "level": "ERROR",
  "code": "BENEFICIARY_TAX_FOREIGNADDRESS_COUNTRYCODE.FORMAT",
  "message": "Поле beneficiary.tax.foreignAddress.countryCode должно содержать двухбуквенный код страны ISO 3166-1 alpha-2",
  "value": "^[A-Z]{2}$"
}