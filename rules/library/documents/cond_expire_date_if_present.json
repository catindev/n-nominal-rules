{
  "id": "library.documents.cond_expire_date_if_present",
  "type": "condition",
  "description": "Если дата окончания документа указана — проверяем формат, затем порядок",
  "when": {
    "all": [
      "library.documents.pred_expire_date_present"
    ]
  },
  "steps": [
    {
      "rule": "library.documents.expire_date_format"
    },
    {
      "condition": "library.documents.cond_expire_date_order_if_format_ok"
    }
  ]
}
