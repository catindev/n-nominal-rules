{
  "id": "library.common.status_end_format",
  "type": "rule",
  "description": "Дата окончания в формате YYYY-MM-DD",
  "role": "check",
  "operator": "matches_regex",
  "level": "ERROR",
  "code": "BEN.STATUS.END_DATE.FORMAT",
  "message": "Дата окончания статуса должна быть в формате YYYY-MM-DD",
  "field": "beneficiary.status.endDate",
  "value": "^\\d{4}-\\d{2}-\\d{2}$"
}